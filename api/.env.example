# Copy to .env and fill in. All variables are prefixed AEOS_.

# REQUIRED in production — generate with: openssl rand -hex 32
AEOS_JWT_SECRET=dev-only-secret-change-me

AEOS_FRONTEND_URL=http://localhost:3000
AEOS_DATABASE_URL=sqlite:///./aeos.db

# --- GitHub OAuth (github.com/settings/developers → New OAuth App) ---
# Callback URL: http://localhost:8000/api/v1/auth/oauth/github/callback
#AEOS_GITHUB_CLIENT_ID=
#AEOS_GITHUB_CLIENT_SECRET=

# --- Google OAuth (console.cloud.google.com → Credentials → OAuth client) ---
# Redirect URI: http://localhost:8000/api/v1/auth/oauth/google/callback
#AEOS_GOOGLE_CLIENT_ID=
#AEOS_GOOGLE_CLIENT_SECRET=

# --- Apple Sign In (developer.apple.com → Certificates, IDs & Profiles) ---
# Requires a paid Apple Developer account. Return URL:
# https://yourdomain/api/v1/auth/oauth/apple/callback (Apple requires HTTPS)
#AEOS_APPLE_CLIENT_ID=
#AEOS_APPLE_TEAM_ID=
#AEOS_APPLE_KEY_ID=
#AEOS_APPLE_PRIVATE_KEY=

# --- Admin ---
# JSON list of emails that get the admin role when they sign up or sign in.
# Admins see the /admin page: enable/disable skills, turn sign-ups on/off.
#AEOS_ADMIN_EMAILS=["you@example.com"]
